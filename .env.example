# Copier en .env (jamais commité) et remplir. Toutes les variables sont facultatives
# sauf IDR_SECRET_KEY. Référence : docs/02_ARCHITECTURE.md § Configuration.

# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
IDR_SECRET_KEY=

# Données (base SQLite, fichiers, recadrages). Sur le Mac mini : hors du dépôt, droits 700.
# IDR_DATA_DIR=/Users/idreader/idreader-data
IDR_BIND=127.0.0.1:8000
IDR_WORKERS=1

IDR_RETENTION_IMAGES_DAYS=30
IDR_RETENTION_DATA_DAYS=365
IDR_AUTO_VALIDATE_THRESHOLD=0.95

# true derrière Caddy (HTTPS) ; false seulement en développement local en http
IDR_COOKIE_SECURE=true

# Moteurs
# IDR_IDVISION_PATH=/Users/idreader/idreader/vision-helper/.build/release/idvision
# IDR_TESSERACT_CMD=/opt/homebrew/bin/tesseract
# IDR_MODELS_DIR=/Users/idreader/idreader/models

# IA locale (phase 6, désactivée par défaut)
IDR_VLM_ENABLED=false
IDR_VLM_MODEL=mlx-community/PaddleOCR-VL-1.6-4bit

# Aucun accès réseau aux hubs de modèles à l'exécution
HF_HUB_OFFLINE=1

# Documents de démonstration UTO (spécimens) : jamais en production
# IDR_ALLOW_SPECIMEN=false
